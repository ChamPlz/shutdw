{
  "name": "shutdw",
  "version": "1.2.1",
  "description": "App Electron para desligar/reiniciar o Windows com acesso web",
  "main": "main.js",
  "author": {
    "name": "ChamPlz",
    "email": "carlos_junior41@hotmail.com"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/ChamPlz/shutdw",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChamPlz/shutdw.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "jest --coverage",
    "test:unit": "jest",
    "build": "electron-builder build --win --publish never",
    "build:win": "electron-builder build --win --publish never",
    "build:linux": "electron-builder build --linux --publish never",
    "build:mac": "electron-builder build --mac --publish never",
    "build:all": "electron-builder build --win --x64 --ia32",
    "publish": "electron-builder build --win --publish always"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^26.8.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "build": {
    "appId": "com.carlos.shutdw",
    "productName": "ShutDW",
    "npmRebuild": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!data",
      "!**/*.md",
      "!.gitignore",
      "!.git",
      "!screenshots/**",
      "!dist/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": {
        "target": "nsis",
        "arch": [
          "x64",
          "ia32"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/argon2/prebuilds/**",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ChamPlz",
        "repo": "shutdw",
        "private": false,
        "releaseType": "release"
      }
    ]
  }
}
